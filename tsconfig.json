{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/lib/site": ["./apps/web/src/lib/site.ts"]
    }
  },
  "include": ["tests/**/*.ts"]
}
