# ==============================================================================
# GCDIS Official Platform - Root Environment Template (.env.example)
# IMPORTANT: Copy this file to .env and configure real production values.
# NEVER commit .env to version control.
# Used by docker-compose.prod.yml (every `:?`-marked variable there is required).
# Generate secrets with e.g.:  openssl rand -hex 32
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000
# Express 'trust proxy' (decides which X-Forwarded-For hop is the client IP for rate limiting
# and lockouts). Hop count (1 = single Nginx in front), true/false, or trusted subnets such as
# "loopback, 10.0.0.0/8". Default when unset: 1 in production, false in development.
# Never expose the API port directly when this is enabled.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# PostgreSQL (three roles are provisioned by infra/postgres/init-roles.sh)
# ------------------------------------------------------------------------------
POSTGRES_DB=gcdis_db
# Superuser (only used by the postgres container itself / break-glass ops)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_SUPERUSER_PASSWORD
# Migration owner (gcdis_admin) - used only by the one-shot `migrate` service
POSTGRES_ADMIN_USER=gcdis_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_SECURE_MIGRATION_PASSWORD
# Least-privilege runtime role (gcdis_app) - used by the API
POSTGRES_APP_USER=gcdis_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_SECURE_RUNTIME_PASSWORD
# Read-only backup role (gcdis_backup) - used by the backup service
POSTGRES_BACKUP_PASSWORD=REPLACE_WITH_SECURE_BACKUP_PASSWORD
# Use URL-safe (alphanumeric/hex) DB passwords: they are embedded in connection URLs.

# Local development / running the API outside Docker (compose builds this itself)
DATABASE_URL="postgresql://gcdis_app:REPLACE_WITH_SECURE_PASSWORD@localhost:5432/gcdis_db?schema=public"

# ------------------------------------------------------------------------------
# Redis Cache & PubSub
# ------------------------------------------------------------------------------
# Alphanumeric/hex only (embedded in REDIS_URL and the generated redis.conf)
REDIS_PASSWORD=REPLACE_WITH_HEX_REDIS_PASSWORD
# Local development only (compose builds REDIS_URL from REDIS_PASSWORD)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Security & Cryptography (Minimum 32 random characters; App refuses to start without it)
# Each value MUST be distinct.
# ------------------------------------------------------------------------------
JWT_SECRET="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTO_SECURE_SECRET_KEY"
# Optional: not read by any code (refresh tokens are opaque, hashed database records). Kept for compatibility.
JWT_REFRESH_SECRET="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTO_SECURE_REFRESH_KEY"
JWT_ADMIN_SECRET="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTO_SECURE_ADMIN_JWT_KEY"
COOKIE_SECRET="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTO_SECURE_COOKIE_SECRET"
TWO_FACTOR_ENCRYPTION_KEY="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTO_SECURE_2FA_KEY"
# Signs accreditation-pass QR codes. REQUIRED in production (>= 32 chars) and must differ from JWT_SECRET.
PASS_SIGNING_SECRET="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTO_SECURE_PASS_SIGNING_KEY"

# ------------------------------------------------------------------------------
# Sign in with Google (optional; team captains only). Leave GOOGLE_CLIENT_ID empty to disable.
# Web client ID from Google Cloud Console > APIs & Services > Credentials (not a secret).
# GOOGLE_ALLOWED_HOSTED_DOMAINS: optional comma list of Workspace domains (hd claim) to allow.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_ALLOWED_HOSTED_DOMAINS=""

# ------------------------------------------------------------------------------
# First-Run Super Admin Provisioning (read by apps/api/prisma/bootstrap-admin.ts)
#   docker compose -f docker-compose.prod.yml --profile bootstrap run --rm bootstrap-admin
# Remove the temp password from .env after the first login reset.
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@yourdomain.org"
SUPER_ADMIN_TEMP_PASSWORD="REPLACE_WITH_STRONG_TEMP_PASS_REQUIRING_FIRST_LOGIN_RESET"

# ------------------------------------------------------------------------------
# Razorpay Production / Test Credentials
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_WITH_RAZORPAY_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET"

# ------------------------------------------------------------------------------
# Site Origins (Used for strict CORS and security header verification)
# ------------------------------------------------------------------------------
PUBLIC_SITE_URL="https://www.gcdis.in"
ADMIN_SITE_URL="https://admin.gcdis.in"
API_BASE_URL="https://api.gcdis.in/api"
WS_ORIGIN="https://admin.gcdis.in"

# Next.js public values: inlined at IMAGE BUILD time (passed as build args)
NEXT_PUBLIC_API_URL="https://api.gcdis.in/api"
NEXT_PUBLIC_WS_URL="wss://api.gcdis.in"
NEXT_PUBLIC_SITE_URL="https://www.gcdis.in"

# ------------------------------------------------------------------------------
# Staff console hardening
# ADMIN_SESSION_MAX_HOURS: absolute lifetime of a staff sign-in (refresh never extends it).
#   Default 12, allowed 1-168. Public portal sessions keep their 7-day lifetime.
# ADMIN_IP_ALLOWLIST: optional comma-separated IPs / CIDR ranges allowed to sign in to and use
#   the staff console, e.g. "203.0.113.10, 10.0.0.0/8, 2001:db8::/32". Empty = disabled.
#   Uses the client IP resolved through TRUST_PROXY. A value with no valid entry denies all staff.
#   Keep it identical to the (commented-out by default) `allow` rules in infra/nginx/admin-allowlist.conf;
#   go-live steps: docs/security/production-checklist.md, "Admin IP allow-list go-live".
# ------------------------------------------------------------------------------
ADMIN_SESSION_MAX_HOURS=12
ADMIN_IP_ALLOWLIST=""
# ADMIN_IDLE_TIMEOUT_MIN: staff sessions end after this many minutes without API activity (default 30, 5-720).
# ADMIN_MAX_SESSIONS: concurrent staff sessions per account (default 3, 1-20); the oldest is signed out.
# ADMIN_LOGOUT_CLEAR_SITE_DATA: Clear-Site-Data on console sign-out (default '"cache", "storage"'; "off"
#   disables it). Adding "cookies" would clear every cookie of the registrable domain (also a portal session
#   in the same browser); the console's own session cookies are cleared by the logout response anyway.
# ADMIN_TRUSTED_TYPES: staff console (admin container) Trusted Types mode. Empty = enforced in production and
#   report-only in development; "report-only" is an emergency switch back to report-only in production.
ADMIN_IDLE_TIMEOUT_MIN=30
ADMIN_MAX_SESSIONS=3
ADMIN_LOGOUT_CLEAR_SITE_DATA='"cache", "storage"'
ADMIN_TRUSTED_TYPES=""

# ------------------------------------------------------------------------------
# File storage
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
# Upload malware scanning (clamd INSTREAM over TCP). docker-compose.prod.yml sets CLAMAV_HOST=clamav itself;
# set it here only for non-compose deployments, e.g. CLAMAV_HOST=clamav. Empty disables scanning.
# CLAMAV_REQUIRED (default true in production): uploads are refused (503) when the scanner is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=true
# Size limit of the championship hero video upload (EVENT_VIDEO, MP4 / WebM, staff only), in MB. Default 60.
# Above 63 also raise client_max_body_size on /api/uploads/stream (infra/nginx/nginx.conf, 64M) and
# StreamMaxLength / MaxFileSize in infra/clamav/clamd.conf (70M).
UPLOAD_VIDEO_MAX_MB=60
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# At-rest encryption of PRIVATE uploads (ID proofs, team documents) and cached invoice PDFs: AES-256-GCM,
# key derived with HKDF-SHA256. Public site imagery (sponsor logos, gallery, site images) is not encrypted.
# REQUIRED in production (the API refuses to start without it): exactly 64 hex characters (32 random bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Outside production an empty value falls back to a development-only key derived from JWT_SECRET (warning logged).
# Keep it with your backups: losing or changing it makes encrypted uploads unreadable. Existing plaintext
# uploads keep working; encrypt them with `npm run uploads:encrypt -- --dry-run`, then without --dry-run.
FILE_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Outgoing email (captain email verification codes and password reset links)
#
# REQUIRED in production: the API refuses to start without SMTP_HOST and MAIL_FROM (and PUBLIC_SITE_URL,
# which every emailed link is built from: {PUBLIC_SITE_URL}/portal/reset-password?token=...).
# Development without SMTP_HOST: nothing is delivered. Each message is written to apps/api/.mail-outbox/
# (git-ignored), the code or link is printed in the API log, and the Team Portal says that email delivery is not
# configured. Fill in the values below and restart the API to send real email.
#
#   SMTP_HOST         SMTP server host name
#   SMTP_PORT         587 = STARTTLS (recommended), 465 = implicit TLS (then SMTP_SECURE=true), 2525 = alt.
#   SMTP_SECURE       true only for implicit TLS on port 465; false for 587 / 2525 (STARTTLS)
#   SMTP_USER         SMTP login (usually the full mailbox address)
#   SMTP_PASSWORD     SMTP password / app password / API key. Never commit a real value.
#   SMTP_REQUIRE_TLS  optional: refuse to send if STARTTLS is not offered (default: true in production)
#   MAIL_FROM         sender shown to recipients; must be an address your provider allows you to send from
#
# After configuring, sign in to the staff console as a Super Administrator and use
# Security > Outgoing Email > "Send Test Email" (it reports the exact SMTP error, without secrets).
#
# Gmail / Google Workspace (needs 2-Step Verification and an App password, NOT the normal password:
# Google Account > Security > 2-Step Verification > App passwords; ~500 recipients/day on free Gmail):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your.account@gmail.com
#   SMTP_PASSWORD="abcd efgh ijkl mnop"   # the 16-letter app password (spaces are ignored)
#   MAIL_FROM="GCDIS Championship <your.account@gmail.com>"   # Gmail sends as the signed-in account
#
# Brevo:     SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<SMTP login shown in Brevo>
#            SMTP_PASSWORD=<SMTP key>        MAIL_FROM must be a verified sender/domain in Brevo
# Resend:    SMTP_HOST=smtp.resend.com       SMTP_PORT=587 (or 465 + SMTP_SECURE=true)
#            SMTP_USER=resend                SMTP_PASSWORD=<re_... API key>  MAIL_FROM on a verified domain
# Zoho Mail: SMTP_HOST=smtp.zoho.com (smtp.zoho.in for India-hosted accounts)  SMTP_PORT=587
#            SMTP_USER=<mailbox address>     SMTP_PASSWORD=<app-specific password>
# Microsoft 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587 (SMTP AUTH must be enabled for the mailbox)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMTP_REQUIRE_TLS=true
MAIL_FROM="GCDIS Championship <no-reply@gcdis.in>"

# Email verification codes (6 digits, valid 15 minutes, 5 wrong attempts). Pending codes are stored
# AES-256-GCM encrypted so administrators can reveal one (step-up, audited) and pass it on by telephone
# while email delivery is unavailable. REQUIRED in production: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Outside production an empty value falls back to a key derived from JWT_SECRET. Changing the key makes
# pending codes unreadable for staff (captains can still request a new code).
VERIFICATION_CODE_KEY=

# Breached-password check (Have I Been Pwned k-anonymity range API; fails open with a warning).
# Set to false if the API host has no outbound internet access.
HIBP_CHECK=true

# ------------------------------------------------------------------------------
# Security alerting (optional): Slack/Discord-compatible webhook (https only) and/or an email address.
# ------------------------------------------------------------------------------
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_EMAIL=

# ------------------------------------------------------------------------------
# Encrypted backups (scripts/backup.sh) - store this key OFF the server too;
# without it backups cannot be decrypted. It must be RANDOM (the integrity key is derived
# from it), never a memorable passphrase. Generate with: openssl rand -hex 32
# Optional: RESTORE_DRILL_PASSWORD for the monthly restore drill (compose profile
# "restore-drill", see docs/security/backup-and-restore.md).
# ------------------------------------------------------------------------------
BACKUP_ENCRYPTION_KEY="REPLACE_WITH_MINIMUM_32_CHAR_BACKUP_ENCRYPTION_PASSPHRASE"
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=

# ------------------------------------------------------------------------------
# Deployment (set by scripts/deploy.sh / CI; optional for local builds)
# ------------------------------------------------------------------------------
# IMAGE_PREFIX=ghcr.io/your-github-org
# IMAGE_TAG=latest

# Tax identifiers printed on GST invoices. Leave empty until the official registration numbers are confirmed;
# placeholder values must never appear on a tax invoice.
INVOICE_GSTIN=
INVOICE_PAN=

# Signs the 5-minute download links for private uploads. Required in production (at least 32 characters,
# different from JWT_SECRET). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPLOAD_SIGNING_SECRET=
